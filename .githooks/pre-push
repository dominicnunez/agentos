#!/bin/sh
set -eu

GO_BIN="${AGENTOS_GO:-go}"

if ! command -v "$GO_BIN" >/dev/null 2>&1; then
  echo "Go is required by the Agent OS pre-push hook. Set AGENTOS_GO to its executable if it is not on PATH."
  exit 1
fi

echo "==> module consistency"
"$GO_BIN" mod tidy -diff

echo "==> build"
"$GO_BIN" build ./...

echo "==> vet"
"$GO_BIN" vet ./...

echo "==> golangci-lint v2.11.4"
"$GO_BIN" run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.11.4 run

echo "==> unit tests"
"$GO_BIN" test ./...

echo "==> vulnerability scan"
"$GO_BIN" run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...

echo "==> architecture boundaries"
"$GO_BIN" tool archguard check --include-tests --profile modular-monolith

base="${GALLOW_BASE:-origin/main}"
echo "==> Gallow advisory audit against $base"
"$GO_BIN" tool gallow audit --base "$base" --format human || true
