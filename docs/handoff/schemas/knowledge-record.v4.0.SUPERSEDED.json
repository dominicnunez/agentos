{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgeRecord v0.1 (VALIDATE NEXT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "kind",
    "provenance_refs",
    "scope",
    "status",
    "created_at"
  ],
  "properties": {
    "knowledge_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "FACT",
        "LESSON",
        "PROCEDURE"
      ]
    },
    "content": {
      "type": "object"
    },
    "content_ref": {
      "type": "string"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "scope": {
      "type": "string"
    },
    "security_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "QUARANTINED",
        "RETIRED"
      ]
    }
  }
}
