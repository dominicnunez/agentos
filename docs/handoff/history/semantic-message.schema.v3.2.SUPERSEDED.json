{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentos/schemas/semantic-message-0.1.json",
  "title": "Agent OS Semantic Message v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "semantic_version",
    "sender",
    "recipients",
    "created_at",
    "priority",
    "kind",
    "payload",
    "canonical_hash"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_version": {
      "const": "0.1"
    },
    "sender": {
      "$ref": "#/$defs/actorRef"
    },
    "recipients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actorRef"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "organization_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "parent_message_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "OBSERVATION",
        "ASSERTION",
        "QUESTION",
        "ANSWER",
        "TASK",
        "BLOCKED",
        "RESULT",
        "CONTRADICTION"
      ]
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "security_labels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "multipleOf": 0.01
    },
    "canonical_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  },
  "$defs": {
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "agent",
            "team"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
