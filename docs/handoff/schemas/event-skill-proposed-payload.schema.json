{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos://schemas/event-skill-proposed-payload/v0.1",
  "title": "SKILL_PROPOSED payload v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "instructions_ref"
  ],
  "properties": {
    "skill_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "instructions_ref": {
      "type": "string"
    },
    "reference_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
