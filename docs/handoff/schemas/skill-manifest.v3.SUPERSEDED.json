{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillManifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "version",
    "state",
    "purpose",
    "required_capabilities",
    "verification"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "QUARANTINED",
        "STALE",
        "REVALIDATING",
        "RETIRED"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_sop": {
      "type": "string"
    },
    "applicability": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
