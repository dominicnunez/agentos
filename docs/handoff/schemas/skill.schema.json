{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos://schemas/skill/v0.2",
  "title": "Skill v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "version",
    "name",
    "description",
    "scope",
    "status",
    "instructions_ref",
    "created_by",
    "created_at"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "AGENT",
            "TEAM",
            "ORGANIZATION"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "VALIDATING",
        "ACTIVE",
        "SUPERSEDED",
        "QUARANTINED",
        "RETIRED"
      ]
    },
    "instructions_ref": {
      "type": "string"
    },
    "reference_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capability_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance_event_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "applicability": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_audited_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
