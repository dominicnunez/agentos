{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dominicnunez/agentos/blob/main/docs/schemas/knowledge-record.schema.json",
  "title": "Governed KnowledgeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id", "organization_id", "version", "type", "scope", "scope_id",
    "status", "title", "content", "basis", "provenance_event_refs",
    "evidence_artifact_refs", "created_by", "created_by_kind", "created_at",
    "validation_method"
  ],
  "properties": {
    "knowledge_id": { "type": "string" },
    "organization_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["EXPERIENCE", "LESSON", "KNOWLEDGE", "PROCEDURE"] },
    "scope": { "enum": ["AGENT", "TEAM", "ORGANIZATION"] },
    "scope_id": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["CANDIDATE", "ACTIVE", "SUPERSEDED", "STALE", "QUARANTINED"] },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "basis": { "enum": ["SINGLE_EXPERIENCE", "REPEATED_PATTERN", "DELIBERATE_EXPERIMENT", "HUMAN_INPUT", "EXTERNAL_EVIDENCE", "DERIVED", "MIXED"] },
    "provenance_event_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "occurrence_event_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "derived_knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "materialization_state"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "materialization_state": { "const": "FULL" }
        }
      },
      "uniqueItems": true
    },
    "evidence_artifact_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "applicability": { "type": "string" },
    "created_by": { "type": "string" },
    "created_by_kind": { "enum": ["RUNTIME", "HUMAN", "AGENT", "EXTERNAL_AGENT"] },
    "created_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "validation_method": { "enum": ["UNVALIDATED", "DETERMINISTIC_CHECK", "EXPERIMENTAL_EVIDENCE", "REPEATED_OBSERVATION", "INDEPENDENT_AGENT_JUDGMENT", "HUMAN_JUDGMENT", "MIXED"] },
    "validation_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "validated_by": { "type": "string" },
    "validated_by_kind": { "enum": ["RUNTIME", "HUMAN", "AGENT", "EXTERNAL_AGENT"] },
    "limitations": { "type": "string" },
    "supersedes_version": { "type": "integer", "minimum": 1 }
  }
}

