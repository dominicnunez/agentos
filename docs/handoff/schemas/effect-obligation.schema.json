{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentos://schemas/effect-obligation/v0.1",
  "title": "EffectObligation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effect_obligation_id",
    "organization_id",
    "task_id",
    "action",
    "resource",
    "effect_fingerprint",
    "authorization_refs",
    "idempotency_key",
    "status",
    "attempt_count",
    "created_at"
  ],
  "properties": {
    "effect_obligation_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "destination": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_effect_descriptor": {
      "type": [
        "object",
        "string"
      ]
    },
    "arguments_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect_fingerprint": {
      "type": "string"
    },
    "authorization_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "replay_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "enum": [
        "PENDING",
        "ATTEMPTED",
        "CONFIRMED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "last_attempt_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "confirmation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
