{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompletionContract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "task_version",
    "criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "assurance",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assurance": {
            "enum": [
              "DETERMINISTIC",
              "EXECUTABLE_TEST",
              "OBJECTIVE_MEASURE",
              "INDEPENDENT_ADJUDICATION",
              "HUMAN_JUDGMENT"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "verifier_ref": {
            "type": "string"
          }
        }
      }
    },
    "forbidden_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
