#!/bin/sh
set -eu

GO_BIN="${AGENTOS_GO:-go}"
GOFMT_BIN="${AGENTOS_GOFMT:-gofmt}"

if ! command -v "$GO_BIN" >/dev/null 2>&1; then
  echo "Go is required by the Agent OS pre-commit hook. Set AGENTOS_GO to its executable if it is not on PATH."
  exit 1
fi

echo "==> staged diff integrity"
git diff --cached --check

echo "==> controlled AIMS documented information"
python3 scripts/verify_aims_documents.py
python3 -m unittest scripts/test_verify_aims_documents.py
python3 -m unittest scripts/test_build_aims_assessment_bundle.py

staged_go="$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')"
if [ -n "$staged_go" ]; then
  if ! command -v "$GOFMT_BIN" >/dev/null 2>&1; then
    echo "gofmt is required by the Agent OS pre-commit hook. Set AGENTOS_GOFMT if it is not on PATH."
    exit 1
  fi
  unformatted=""
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    if ! git cat-file -e ":$file"; then
      echo "Unable to read staged Go file: $file"
      exit 1
    fi
    if ! format_result="$(git show ":$file" | "$GOFMT_BIN" -l)"; then
      echo "gofmt could not parse staged Go file: $file"
      exit 1
    fi
    if [ -n "$format_result" ]; then
      if [ -n "$unformatted" ]; then
        unformatted="$unformatted
$file"
      else
        unformatted="$file"
      fi
    fi
  done <<EOF
$staged_go
EOF
  if [ -n "$unformatted" ]; then
    echo "The following staged Go files require gofmt:"
    printf '%s\n' "$unformatted"
    exit 1
  fi
fi

echo "==> unit tests"
"$GO_BIN" test ./...

echo "==> architecture boundaries"
"$GO_BIN" tool archguard check --include-tests --profile modular-monolith
