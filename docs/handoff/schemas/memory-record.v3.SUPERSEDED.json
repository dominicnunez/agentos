{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRecord v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "kind",
    "state",
    "content_ref",
    "provenance",
    "confidence"
  ],
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "EPISODIC",
        "SEMANTIC",
        "LESSON"
      ]
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "QUARANTINED",
        "STALE",
        "REVALIDATING",
        "RETIRED"
      ]
    },
    "content_ref": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "last_verified": {
      "type": "string",
      "format": "date-time"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "security_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
