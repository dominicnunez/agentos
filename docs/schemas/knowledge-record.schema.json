{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dominicnunez/agentos/blob/main/docs/schemas/knowledge-record.schema.json",
  "title": "Governed KnowledgeRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id", "organization_id", "version", "type", "scope", "scope_id",
    "status", "title", "content", "basis", "provenance_event_refs",
    "evidence_artifact_refs", "created_by", "created_by_kind", "created_at",
    "validation_method"
  ],
  "properties": {
    "knowledge_id": { "type": "string" },
    "organization_id": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "type": { "enum": ["EXPERIENCE", "LESSON", "KNOWLEDGE", "PROCEDURE"] },
    "scope": { "enum": ["AGENT", "TEAM", "ORGANIZATION"] },
    "scope_id": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": { "enum": ["CANDIDATE", "ACTIVE", "SUPERSEDED", "STALE", "QUARANTINED"] },
    "title": { "type": "string" },
    "content": { "type": "string" },
    "basis": { "enum": ["SINGLE_EXPERIENCE", "REPEATED_PATTERN", "DELIBERATE_EXPERIMENT", "HUMAN_INPUT", "EXTERNAL_EVIDENCE", "DERIVED", "MIXED"] },
    "provenance_event_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "occurrence_event_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "derived_knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "materialization_state"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "materialization_state": { "const": "FULL" }
        }
      },
      "uniqueItems": true
    },
    "evidence_artifact_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "applicability": { "type": "string" },
    "created_by": { "type": "string" },
    "created_by_kind": { "enum": ["RUNTIME", "HUMAN", "AGENT", "EXTERNAL_AGENT"] },
    "created_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "validation_method": { "enum": ["UNVALIDATED", "DETERMINISTIC_CHECK", "EXPERIMENTAL_EVIDENCE", "REPEATED_OBSERVATION", "INDEPENDENT_AGENT_JUDGMENT", "HUMAN_JUDGMENT", "MIXED"] },
    "validation_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "validated_by": { "type": "string" },
    "validated_by_kind": { "enum": ["RUNTIME", "HUMAN", "AGENT", "EXTERNAL_AGENT"] },
    "limitations": { "type": "string" },
    "supersedes_version": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "basis": { "const": "REPEATED_PATTERN" } }, "required": ["basis"] },
      "then": { "required": ["occurrence_event_refs"], "properties": { "occurrence_event_refs": { "minItems": 3 } } }
    },
    {
      "if": { "properties": { "basis": { "const": "DERIVED" } }, "required": ["basis"] },
      "then": { "required": ["derived_knowledge_refs"], "properties": { "derived_knowledge_refs": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "const": "CANDIDATE" } }, "required": ["status"] },
      "then": {
        "properties": {
          "validation_method": { "const": "UNVALIDATED" },
          "validation_refs": { "maxItems": 0 },
          "validated_by": { "maxLength": 0 }
        },
        "not": { "anyOf": [
          { "required": ["validated_by_kind"] },
          { "required": ["last_verified_at"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } }, "required": ["status"] },
      "then": {
        "required": ["validation_refs", "validated_by", "validated_by_kind", "last_verified_at"],
        "properties": {
          "validation_method": { "not": { "const": "UNVALIDATED" } },
          "validation_refs": { "minItems": 1 },
          "validated_by": { "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["SUPERSEDED", "STALE", "QUARANTINED"] } }, "required": ["status"] },
      "then": {
        "properties": { "version": { "minimum": 2 } },
        "oneOf": [
          {
            "properties": {
              "validation_method": { "const": "UNVALIDATED" },
              "validation_refs": { "maxItems": 0 },
              "validated_by": { "maxLength": 0 }
            },
            "not": { "anyOf": [
              { "required": ["validated_by_kind"] },
              { "required": ["last_verified_at"] }
            ] }
          },
          {
            "required": ["validation_refs", "validated_by", "validated_by_kind", "last_verified_at"],
            "properties": {
              "validation_method": { "not": { "const": "UNVALIDATED" } },
              "validation_refs": { "minItems": 1 },
              "validated_by": { "minLength": 1 }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "validation_method": { "const": "HUMAN_JUDGMENT" } }, "required": ["validation_method"] },
      "then": { "properties": { "validated_by_kind": { "const": "HUMAN" } } }
    },
    {
      "if": { "properties": { "validation_method": { "const": "INDEPENDENT_AGENT_JUDGMENT" } }, "required": ["validation_method"] },
      "then": { "properties": { "validated_by_kind": { "enum": ["AGENT", "EXTERNAL_AGENT"] } } }
    },
    {
      "if": { "properties": { "validation_method": { "const": "REPEATED_OBSERVATION" } }, "required": ["validation_method"] },
      "then": { "required": ["validation_refs"], "properties": { "validation_refs": { "minItems": 3 } } }
    }
  ]
}
